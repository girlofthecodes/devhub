# DevHub — Servidor B (datos). Copia a /etc/devhub/server-b.env (chmod 600).

# Superusuario de PostgreSQL: solo para administración; las apps usan roles propios.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=__GENERAR__

# IP de ESTE servidor en la VPN: PostgreSQL solo escucha aquí (nunca 0.0.0.0).
VPN_BIND_IP=10.66.0.2
POSTGRES_PORT=5432
# Subred de la VPN autorizada en pg_hba.conf.
DB_ALLOWED_CIDR=10.66.0.0/24

# --- Backups (scripts/backup.sh) ---
DB_CONTAINER=devhub-data-postgres-1
PGUSER=postgres
BACKUP_DIR=/var/backups/devhub
BACKUP_RETENTION_DAYS=14
# Copia externa opcional con rclone (p. ej. "b2:devhub-backups/server-b"). Vacío = desactivada.
BACKUP_REMOTE=
# Cifrado opcional con age (clave pública). Vacío = sin cifrar.
BACKUP_AGE_RECIPIENT=
