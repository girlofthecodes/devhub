# DevHub — Servidor A (producción / Home Lab). Copia a /etc/devhub/server-a.env (chmod 600).
# Ningún valor real debe subirse al repositorio. Genera los secretos con scripts/setup.sh.

# --- Django ---
DJANGO_SECRET_KEY=__GENERAR__                       # >= 50 caracteres aleatorios
DJANGO_ALLOWED_HOSTS=devhub.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://devhub.example.com
# cloudflared + Caddy delante de Django (ver docs/homelab.md#proxies-de-confianza)
DJANGO_NUM_PROXIES=2
DJANGO_HSTS_SECONDS=2592000
DJANGO_ADMIN_ENABLED=true
FRONTEND_URL=https://devhub.example.com
DEVHUB_ALLOWED_PUBLIC_DOMAINS=example.com

# --- PostgreSQL en el Servidor B, por la VPN ---
POSTGRES_HOST=10.66.0.2                             # IP de WireGuard/Tailscale del Servidor B
POSTGRES_PORT=5432
POSTGRES_DB=devhub
POSTGRES_USER=app_devhub                            # rol creado con scripts/create-app-db.sh --app devhub
POSTGRES_PASSWORD=__GENERAR__                       # credencial exclusiva de DevHub
DB_SSLMODE=prefer                                   # el canal ya va cifrado por la VPN
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_WAIT_SECONDS=90

# --- Correo (recuperación de contraseña) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DevHub <no-reply@example.com>

# --- Portal / monitoreo / retención ---
PUBLIC_PORTFOLIO_ENABLED=true
MONITOR_ALLOWED_PORTS=443
TRACE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
CHECK_RESULT_RETENTION_DAYS=30

# --- Compose ---
PROXY_LOCAL_PORT=8080
# Token del túnel (Zero Trust → Networks → Tunnels). Solo con el perfil "tunnel".
CLOUDFLARE_TUNNEL_TOKEN=
