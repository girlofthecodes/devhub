# ---------------------------------------------------------------------------
# DevHub — variables de entorno para DESARROLLO LOCAL.
# Copia este archivo a `.env` (nunca lo subas al repositorio).
# Los valores aquí son marcadores de posición válidos SOLO en local.
# ---------------------------------------------------------------------------

# --- Puertos publicados en el host (solo 127.0.0.1) ---
FRONTEND_PORT=5173
BACKEND_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=local-dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Si cambias FRONTEND_PORT, actualiza también estas URLs y FRONTEND_URL.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=
# Número de proxies de confianza delante de Django (0 en local, 1+ detrás de reverse proxy)
DJANGO_NUM_PROXIES=0
# URL pública del frontend (usada en enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# --- Administrador inicial (solo se crea si no existe) ---
DJANGO_ADMIN_EMAIL=admin@devhub.local
DJANGO_ADMIN_PASSWORD=ChangeMe-Local-2026!

# --- PostgreSQL ---
POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub_local_only
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSLMODE=prefer

# --- Correo (en local se imprime en la consola del backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DevHub <no-reply@devhub.local>

# --- Infraestructura ---
# Dominios autorizados para URLs públicas de entornos y sitios (vacío = cualquier dominio público).
# Ejemplo: DEVHUB_ALLOWED_PUBLIC_DOMAINS=girlofthecodes.dev,example.com
DEVHUB_ALLOWED_PUBLIC_DOMAINS=

# --- Trazabilidad ---
# Retención en días aplicada por `manage.py purge_history` (mínimo 30).
TRACE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730

# --- Portal de clientes ---
PUBLIC_PORTFOLIO_ENABLED=true
# Segundos para abrir la demo tras pulsar "Abrir demo" (ticket de un solo uso).
DEMO_TOKEN_TTL_SECONDS=300
# Duración de la sesión que la aplicación demo concede tras validar el ticket.
DEMO_SESSION_MINUTES=120

# --- Monitoreo (worker `run_monitor`) ---
MONITOR_ALLOWED_PORTS=443,8443
MONITOR_MIN_INTERVAL_SECONDS=60
MONITOR_LOOP_SECONDS=15
CHECK_RESULT_RETENTION_DAYS=30

# --- Métricas internas y alertas (Fase 8) ---
METRIC_SAMPLE_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=365
# Una app que reportó y deja de hacerlo este tiempo abre "Sin métricas recientes".
MONITOR_METRICS_STALE_SECONDS=600
# Umbrales (advertencia / crítica)
MONITOR_ALERT_CPU_WARN=85
MONITOR_ALERT_CPU_CRIT=95
MONITOR_ALERT_MEMORY_WARN=85
MONITOR_ALERT_MEMORY_CRIT=95
MONITOR_ALERT_ERROR_RATE_WARN=5
MONITOR_ALERT_ERROR_RATE_CRIT=15
MONITOR_ALERT_LATENCY_WARN_MS=1500
MONITOR_ALERT_LATENCY_CRIT_MS=3000
THROTTLE_METRICS=600/min
