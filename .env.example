# ---------------------------------------------------------------------------
# DevHub — variables de entorno para DESARROLLO LOCAL.
# Copia este archivo a `.env` (nunca lo subas al repositorio).
# Los valores aquí son marcadores de posición válidos SOLO en local.
# ---------------------------------------------------------------------------

# --- Puertos publicados en el host (solo 127.0.0.1) ---
FRONTEND_PORT=5173
BACKEND_PORT=8000

# --- Django ---
DJANGO_SECRET_KEY=local-dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Si cambias FRONTEND_PORT, actualiza también estas URLs y FRONTEND_URL.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CORS_ALLOWED_ORIGINS=
# Número de proxies de confianza delante de Django (0 en local, 1+ detrás de reverse proxy)
DJANGO_NUM_PROXIES=0
# URL pública del frontend (usada en enlaces de recuperación de contraseña)
FRONTEND_URL=http://localhost:5173

# --- Administrador inicial (solo se crea si no existe) ---
DJANGO_ADMIN_EMAIL=admin@devhub.local
DJANGO_ADMIN_PASSWORD=ChangeMe-Local-2026!

# --- PostgreSQL ---
POSTGRES_DB=devhub
POSTGRES_USER=devhub
POSTGRES_PASSWORD=devhub_local_only
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=15000
DB_SSLMODE=prefer

# --- Correo (en local se imprime en la consola del backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DevHub <no-reply@devhub.local>

# --- Infraestructura ---
# Dominios autorizados para URLs públicas de entornos y sitios (vacío = cualquier dominio público).
# Ejemplo: DEVHUB_ALLOWED_PUBLIC_DOMAINS=girlofthecodes.dev,example.com
DEVHUB_ALLOWED_PUBLIC_DOMAINS=

# --- Trazabilidad ---
# Retención en días aplicada por `manage.py purge_history` (mínimo 30).
TRACE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=730
